# Configuración para desarrollo local
# Copiar este archivo a .env para usar

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Ruta del dataset
DATA_PATH=data/ods_data.csv

# Puerto de desarrollo
PORT=5000
HOST=0.0.0.0

# Otros ajustes
SECRET_KEY=dev-secret-key-change-in-production
TESTING=False
